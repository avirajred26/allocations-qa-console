# ---- GitHub (fine-grained PAT, Actions: read/write on THIS repo only) ----
GH_TOKEN=
GH_OWNER=avirajred26
GH_REPO=allocations-qa-console
GH_WORKFLOW=qa-run.yml
GH_BRANCH=main

# ---- Demo key ----
# Generate the key:        openssl rand -base64 32
# Store only its hash:     printf '%s' "$KEY" | sha256sum | cut -d' ' -f1
# Hand the KEY to reviewers in the submission message. Rotate after review.
DEMO_KEY_HASH=

# ---- Upstash Redis (Vercel marketplace → Upstash, free tier) ----
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Test seam ONLY — never set in production.
# ALLOW_TEST_NAMESPACE=1        enables x-trigger-namespace header (per-test Redis keys)
# TEST_COOLDOWN_SECONDS=1       shorter cooldown for tests (1–30; ignored without the seam)
# TEST_DISPATCH_MODE=accept     accept | reject | uncertain — fixed dispatch outcome, no GitHub call
# TEST_ACQUIRE_TIMEOUT_MS=0     fire the local ACQUIRE timeout before Redis replies (exercises CANCEL ordering)
